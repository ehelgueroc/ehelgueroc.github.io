---
import { getCollection, render } from "astro:content";

const entries = (await getCollection("timeline")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const items = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const years = (start: string, end: string | null) =>
  `${start.slice(0, 4)} – ${end ? end.slice(0, 4) : "Present"}`;
---

<section class="career" aria-labelledby="career-title">
  <h2 id="career-title" class="section-title">
    Career
  </h2>
  <div class="tl">
    <span class="tl-line" aria-hidden="true"></span>
    <ol>
      {items.map(({ entry, Content }, i) => (
        <li class:list={["item", i % 2 === 0 ? "left" : "right"]}>
          <span class="dot" aria-hidden="true" />
          <details class="card">
            <summary>
              <span class="pill pill--grad">
                {years(entry.data.start, entry.data.end)}
              </span>
              <h3>{entry.data.title}</h3>
              <span class="company">{entry.data.company}</span>
              <span class="summary">{entry.data.summary}</span>
              <span class="tags">
                {entry.data.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </span>
              <span class="more">
                <span class="when-closed">Details</span>
                <span class="when-open">Hide details</span>
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="detail">
              <div class="detail-inner">
                <p class="location">{entry.data.location}</p>
                <Content />
              </div>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Motion B (issues/005-animation-behaviour.md). Nothing here runs under reduced motion:
  // entries are then visible from the start, the line is fully drawn and <details> opens instantly.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const timeline = document.querySelector<HTMLElement>(".tl");

  if (!reduced && timeline) {
    // Cards slide in from their side once, as they enter the viewport.
    const observer = new IntersectionObserver(
      (records) => {
        for (const record of records) {
          if (!record.isIntersecting) continue;
          record.target.classList.add("in");
          observer.unobserve(record.target);
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
    );
    timeline
      .querySelectorAll(".item")
      .forEach((item) => observer.observe(item));

    // The centre line draws with scroll progress, updated at most once per frame.
    let queued = false;
    const drawLine = () => {
      queued = false;
      const box = timeline.getBoundingClientRect();
      const progress = Math.min(
        1,
        Math.max(0, (window.innerHeight * 0.75 - box.top) / box.height),
      );
      timeline.style.setProperty("--p", progress.toFixed(3));
    };
    window.addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(drawLine);
      },
      { passive: true },
    );
    drawLine();

    // Smooth expand/collapse of <details>; keyboard and screen-reader behaviour stay native.
    timeline.querySelectorAll("details").forEach((details) => {
      const body = details.querySelector<HTMLElement>(".detail");
      details.querySelector("summary")?.addEventListener("click", (event) => {
        if (!body) return;
        event.preventDefault();
        const opening = !details.open;
        if (opening) details.open = true;
        const height = `${body.scrollHeight}px`;
        const animation = body.animate(
          [
            { height: opening ? "0px" : height, opacity: opening ? 0 : 1 },
            { height: opening ? height : "0px", opacity: opening ? 1 : 0 },
          ],
          { duration: 260, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" },
        );
        animation.onfinish = () => {
          if (!opening) details.open = false;
        };
      });
    });
  }
</script>

<style>
  .career {
    margin-bottom: 96px;
  }

  .tl {
    --p: 1;
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  .tl-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 3px;
    background: var(--line-grad);
    transform: translateX(-50%) scaleY(var(--p));
    transform-origin: top;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    width: 50%;
    padding: 0 40px 40px 0;
  }

  .item.right {
    margin-left: 50%;
    padding: 0 0 40px 40px;
  }

  .dot {
    position: absolute;
    top: 22px;
    right: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--dot);
  }

  .item.right .dot {
    left: -9px;
    right: auto;
  }

  details {
    padding: 20px 22px;
  }

  summary {
    display: block;
    list-style: none;
    cursor: pointer;
    border-radius: 8px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    margin: 10px 0 0;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 750;
  }

  .company {
    display: block;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  .summary {
    display: block;
    margin: 8px 0 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .when-open,
  details[open] .when-closed {
    display: none;
  }

  details[open] .when-open {
    display: inline;
  }

  details[open] .more svg {
    transform: rotate(180deg);
  }

  .detail {
    overflow: hidden;
  }

  .detail-inner {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }

  .location {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .detail-inner :global(ul) {
    margin: 8px 0 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (max-width: 760px) {
    .tl-line {
      left: 8px;
      transform: scaleY(var(--p));
    }
    .item,
    .item.right {
      width: 100%;
      margin-left: 0;
      padding: 0 0 28px 36px;
    }
    .dot,
    .item.right .dot {
      left: 0;
      right: auto;
    }
  }

  /* Hidden-until-revealed only applies with JS and without reduced motion, so no visitor can get stuck
     with invisible content. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tl {
      --p: 0;
    }
    :global(.js) .item {
      transition:
        opacity 350ms ease-out,
        transform 350ms var(--ease-out);
    }
    :global(.js) .item:not(.in) {
      opacity: 0;
      transform: translateX(-28px);
    }
    :global(.js) .item.right:not(.in) {
      transform: translateX(28px);
    }
    :global(.js) .dot {
      transition: transform 250ms cubic-bezier(0.3, 1.6, 0.5, 1) 120ms;
    }
    :global(.js) .item:not(.in) .dot {
      transform: scale(0);
    }
    .more svg {
      transition: transform 250ms ease;
    }
    @media (max-width: 760px) {
      :global(.js) .item.right:not(.in) {
        transform: translateX(-28px);
      }
    }
  }
</style>
