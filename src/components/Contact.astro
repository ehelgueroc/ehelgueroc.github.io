---
import { getEntry } from "astro:content";

const contact = await getEntry("contact", "contact");
if (!contact) throw new Error("src/content/contact.md is missing");
const { heading, line, email, linkedin, cvHref } = contact.data;
---

<section class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" data-reveal>
    {heading}
  </h2>
  <p data-reveal style="--d: 70ms">
    {line}
  </p>
  <nav class="links" aria-label="Get in touch" data-reveal style="--d: 140ms">
    <a class="button button--primary" href={`mailto:${email}`}>
      {email}
    </a>
    {cvHref && (
      <a class="button" href={cvHref} download>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12" />
          <path d="M7 10l5 5 5-5" />
          <path d="M5 21h14" />
        </svg>
        Download CV (PDF)
      </a>
    )}
    <a class="button" href={linkedin}>
      LinkedIn
    </a>
  </nav>
</section>

<style>
  .contact {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 0 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  h2 {
    margin: 0;
    font-size: clamp(36px, 6vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  p {
    margin: 0;
    font-size: 18px;
    color: var(--muted);
  }

  .links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .button {
    min-height: 48px;
    padding: 0 24px;
    font-size: 15px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
