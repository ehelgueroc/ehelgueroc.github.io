<!--
  The page's single scroll-reveal: adds .in to every [data-reveal] element once it enters the viewport,
  and counts up numeric Highlights values (data-count).
  - data-reveal (plain): fades up 16 px (global.css), delayed by data-delay ms for staggering.
    Delays are applied through CSSOM rather than style="" attributes so the CSP needn't allow inline styles.
  - data-reveal="side": Timeline cards; their slide-from-the-side styles live in Timeline.astro.
  See issues/005 and issues/011. Nothing runs under reduced motion, and without JS the
  hidden-until-revealed styles never apply (they're gated on the .js class).
-->
<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // "15+" → 0…15+ over 700 ms. Values that aren't a plain number (e.g. "Monthly") stay as they are.
  const countUp = (el: HTMLElement) => {
    const match = el.textContent?.trim().match(/^(\d+)(\+?)$/);
    if (!match) return;
    const target = Number(match[1]);
    const suffix = match[2];
    const started = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - started) / 700);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = `${Math.round(target * eased)}${suffix}`;
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (!reduced) {
    const observer = new IntersectionObserver(
      (records) => {
        for (const record of records) {
          if (!record.isIntersecting) continue;
          const el = record.target as HTMLElement;
          el.classList.add("in");
          el.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
          observer.unobserve(el);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
      if (el.dataset.delay)
        el.style.setProperty("--d", `${el.dataset.delay}ms`);
      observer.observe(el);
    });
  }
</script>
