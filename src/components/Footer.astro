---
import { getEntry } from "astro:content";

const [intro, contact] = await Promise.all([
  getEntry("intro", "intro"),
  getEntry("contact", "contact"),
]);
// The year comes from the build, so it never goes stale.
const year = new Date().getFullYear();
---

<footer>
  <span>
    © {year} {intro?.data.name}
  </span>
  <span>{contact?.data.footerNote}</span>
</footer>

<style>
  footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 0 40px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
