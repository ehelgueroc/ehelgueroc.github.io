---
import { getEntry } from "astro:content";

const lookingFor = await getEntry("lookingFor", "looking-for");
if (!lookingFor) throw new Error("src/content/looking-for.md is missing");
const { visible, badge, role, setup, timezone, interests } = lookingFor.data;

const facts = [
  { label: "Role", value: role },
  { label: "Work setup", value: setup },
  { label: "Time zone", value: timezone },
  { label: "Interested in", value: interests },
];
---

{visible && (
  <section class="looking-for card" aria-labelledby="looking-for-title">
    <div class="head">
      <h2 id="looking-for-title">What I'm looking for</h2>
      <span class="pill pill--grad">{badge}</span>
    </div>
    <dl>
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .looking-for {
    max-width: 1100px;
    margin: 0 auto 96px;
    padding: 40px 44px;
    border-radius: 20px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .pill {
    padding: 6px 14px;
    font-size: 13px;
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  dt {
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0;
    line-height: 1.5;
  }

  /* Provisional reflow until "Design the new sections for light mode, mobile and motion" settles it. */
  @media (max-width: 900px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .looking-for {
      padding: 28px 22px;
    }
    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
</style>
