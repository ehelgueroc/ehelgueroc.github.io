---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Hero from "../components/Hero.astro";
import HighlightsStrip from "../components/HighlightsStrip.astro";
import Timeline from "../components/Timeline.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import LookingFor from "../components/LookingFor.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import RevealOnScroll from "../components/RevealOnScroll.astro";

const intro = await getEntry("intro", "intro");
if (!intro) throw new Error("src/content/intro.md is missing");

// <head> metadata, as settled in issues/007-define-page-metadata.md.
const { name, title: jobTitle, description, location, links } = intro.data;
const title = `${name} · ${jobTitle}`;
const currentRole = (await getCollection("timeline")).find(
  (entry) => entry.data.end === null,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  jobTitle,
  url: Astro.site?.href,
  homeLocation: { "@type": "Place", name: location.split(" · ")[0] },
  sameAs: links
    .map((link) => link.href)
    .filter((href) => href.startsWith("http")),
  knowsAbout: currentRole?.data.tags ?? [],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <ThemeToggle />
  <Hero />
  <main>
    <HighlightsStrip />
    <Timeline />
    <FeaturedProjects />
    <LookingFor />
    <Contact />
  </main>
  <Footer />
  <RevealOnScroll />
</BaseLayout>
